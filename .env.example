POSTGRES_DB=offerpilot
POSTGRES_USER=offerpilot
POSTGRES_PASSWORD=change-this-local-password
OFFERPILOT_ENVIRONMENT=development
OFFERPILOT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
OFFERPILOT_ALLOWED_ORIGINS=["http://localhost:3000"]
# Optional OpenAI-compatible Chat Completions settings for Agent job extraction.
OFFERPILOT_LLM_BASE_URL=
OFFERPILOT_LLM_API_KEY=
OFFERPILOT_LLM_MODEL=
OFFERPILOT_LLM_TIMEOUT_SECONDS=30
OFFERPILOT_LLM_LOW_CONFIDENCE_THRESHOLD=0.75
# OpenAI-compatible Embeddings settings for resume/note indexing and semantic search.
OFFERPILOT_EMBEDDING_BASE_URL=
OFFERPILOT_EMBEDDING_API_KEY=
OFFERPILOT_EMBEDDING_MODEL=

# Read-only public search used by MCP company research.
# Create a Tavily API key and keep it server-side; never send it to the browser.
OFFERPILOT_TAVILY_API_KEY=
OFFERPILOT_RESEARCH_TIMEOUT_SECONDS=12
# Celery task broker. Docker Compose overrides this with its Redis service hostname.
OFFERPILOT_CELERY_BROKER_URL=redis://localhost:6379/0
